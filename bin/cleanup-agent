import glob
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import time

HOME = os.path.expanduser("~")
LOG_DIR = os.path.join(HOME, "Library", "Logs", "cleanup-agent")
REPORT_DIR = LOG_DIR
LOG_PATH = os.path.join(LOG_DIR, "cleanup.log")
CONFIG_DIR = os.path.join(HOME, ".config", "cleanup-agent")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
EXCLUDES_PATH = os.path.join(CONFIG_DIR, "excludes")
QUARANTINE_DIR = os.path.join(HOME, "Library", "Application Support", "cleanup-agent", "quarantine")
QUARANTINE_DAYS = 7

SAFE = "safe"
MEDIUM = "medium"
RISKY = "risky"


def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return ("%.1f %s" % (n, unit)) if unit != "B" else ("%d B" % n)
        n /= 1024.0


def run(cmd, timeout=90):
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           timeout=timeout)
        return p.stdout.decode("utf-8", "replace")
    except Exception:
        return ""


def du_bytes(path):
    if not os.path.exists(path):
        return 0
    out = run(["/usr/bin/du", "-sk", path], timeout=60).strip()
    try:
        return int(out.split()[0]) * 1024
    except Exception:
        return 0


def disk_info():
    out = run(["/bin/df", "-k", "/System/Volumes/Data"], timeout=30)
    lines = out.splitlines()
    if len(lines) >= 2:
        f = lines[1].split()
        if len(f) >= 4:
            try:
                return {"total": int(f[1]) * 1024, "used": int(f[2]) * 1024,
                        "free": int(f[3]) * 1024}
            except Exception:
                pass
    st = shutil.disk_usage("/System/Volumes/Data")
    return {"total": st.total, "used": st.used, "free": st.free}


def machine_info():
    name = run(["/usr/sbin/scutil", "--get", "ComputerName"], timeout=15).strip()
    hw = run(["/usr/sbin/system_profiler", "SPHardwareDataType"], timeout=60)

    def f(label):
        m = re.search(label + r":\s*(.+)", hw)
        return m.group(1).strip() if m else ""

    return {"name": name or "Mac",
            "model": f("Model Name"),
            "model_id": f("Model Identifier"),
            "chip": f("Chip"),
            "memory": f("Memory")}


DISPLAY = {
    "inc.attention.rem": "Coast", "so.cap.desktop": "Cap",
    "com.apple.wallpaper": "Fondos", "Pictures": "Fotos", "Music": "Música",
    "discord": "Discord", "Zoho Mail - Desktop": "Zoho Mail",
    "ai.opencode.desktop": "OpenCode", "com.operasoftware.Opera": "Opera",
    "com.raycast.macos": "Raycast", "com.wiheads.paste-setapp": "Paste",
    "Setapp": "Setapp", "Mobile Documents": "iCloud Drive",
}


def display_name(path):
    b = os.path.basename(path.rstrip("/"))
    return DISPLAY.get(b, b)


def bar(pct, n=10):
    pct = max(0, min(100, pct))
    filled = int(round(pct / 100.0 * n))
    return "▓" * filled + "░" * (n - filled)


def top_consumers(n=8):
    paths = expand(os.path.join(HOME, "Library", "Application Support", "*"))
    for d in ("Desktop", "Documents", "Downloads", "Movies", "Music", "Pictures"):
        p = os.path.join(HOME, d)
        if os.path.exists(p):
            paths.append(p)
    if not paths:
        return []
    out = run(["/usr/bin/du", "-sk"] + paths, timeout=600)
    rows = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 2:
            try:
                rows.append((int(parts[0]) * 1024, parts[1]))
            except Exception:
                pass
    rows.sort(reverse=True)
    return rows[:n]


_DISK_CACHE = {"ts": 0, "items": None}


def top_subdirs(base, n=5):
    if not os.path.isdir(base):
        return []
    out = run(["/usr/bin/du", "-sk"] + expand(os.path.join(base, "*")), timeout=300)
    rows = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 2:
            try:
                rows.append((int(parts[0]) * 1024, parts[1]))
            except Exception:
                pass
    rows.sort(reverse=True)
    return rows[:n]


def disk_breakdown(force=False):
    now = time.time()
    if not force and _DISK_CACHE.get("items") and now - _DISK_CACHE.get("ts", 0) < 600:
        return _DISK_CACHE["items"]
    apps = du_bytes("/Applications")
    home = du_bytes(HOME)
    subs = [
        ("🖼️", "Fotos", [os.path.join(HOME, "Pictures")]),
        ("🎵", "Música", [os.path.join(HOME, "Music")]),
        ("🎬", "Videos", [os.path.join(HOME, "Movies")]),
        ("📄", "Documentos", [os.path.join(HOME, "Documents"), os.path.join(HOME, "Desktop")]),
        ("⬇️", "Descargas", [os.path.join(HOME, "Downloads")]),
        ("☁️", "iCloud", [os.path.join(HOME, "Library", "Mobile Documents")]),
        ("🗂️", "Cachés", [os.path.join(HOME, "Library", "Caches"), os.path.join(HOME, ".cache")]),
        ("⚙️", "Datos de apps", [os.path.join(HOME, "Library", "Application Support")]),
        ("🧰", "Contenedores", [os.path.join(HOME, "Library", "Containers"),
                                os.path.join(HOME, "Library", "Group Containers")]),
    ]
    items = [{"emoji": "📦", "name": "Aplicaciones", "bytes": apps}]
    total_sub = 0
    for emoji, name, paths in subs:
        size = sum(du_bytes(p) for p in paths)
        total_sub += size
        items.append({"emoji": emoji, "name": name, "bytes": size})
    items.append({"emoji": "🗃️", "name": "Resto de tu carpeta", "bytes": max(0, home - total_sub)})
    used = disk_info()["used"]
    items.append({"emoji": "🖥️", "name": "Sistema y otros", "bytes": max(0, used - apps - home)})
    items = [i for i in items if i["bytes"] > 0]
    items.sort(key=lambda x: -x["bytes"])
    _DISK_CACHE.update({"ts": now, "items": items})
    return items


def log(msg):
    os.makedirs(LOG_DIR, exist_ok=True)
    with open(LOG_PATH, "a") as f:
        f.write("[%s] %s\n" % (datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"), msg))


def expand(pattern):
    return sorted(glob.glob(pattern))


def item(name, path, risk, action="delete", kind="dir", note=""):
    if kind != "brew" and path and os.path.exists(path):
        kind = "file" if os.path.isfile(path) else "dir"
    return {"name": name, "path": path, "risk": risk, "action": action,
            "kind": kind, "bytes": du_bytes(path), "note": note}


