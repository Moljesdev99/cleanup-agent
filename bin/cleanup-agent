def icon_for(name):
    low = (name + " " + display_name(name)).lower()
    for k, v in ICONS:
        if k in low:
            return v
    return "•"


def _desc_by_key(key):
    for k, emoji, title, desc in DESC:
        if k == key:
            return k, emoji, title, desc
    return "generic", "•", "Elemento", "Archivo temporal. Revísalo antes de borrar."


def _desc_match(name):
    low = name.lower()
    # Las cachés se explican como caché (aunque su nombre contenga "iCloud", "Discord", etc.)
    if low.startswith(("cache: ", "~/.cache: ")):
        for key in ("homebrew", "aside", "claude", "orbstack"):
            if key in low:
                return _desc_by_key(key)
        return _desc_by_key("cache")
    for pre, key in (("logs: ", "logs"), ("notion: ", "notion"), ("discord: ", "discord"),
                     ("updater: ", "updater"), ("aside: ", "aside"), ("orbstack", "orbstack"),
                     ("safari", "safari"), ("papelera", "papelera"), ("trash", "trash")):
        if low.startswith(pre):
            return _desc_by_key(key)
    for key, emoji, title, desc in DESC:
        if key in low:
            return key, emoji, title, desc
    return "generic", "•", "Elemento", "Archivo temporal. Revísalo antes de borrar."


def describe(name):
    _, emoji, title, desc = _desc_match(name)
    return emoji, title, desc


def dir_summary(path):
    n = 0
    total = 0
    mn = None
    mx = None
    try:
        for root, dirs, files in os.walk(path):
            for f in files:
                try:
                    st = os.stat(os.path.join(root, f))
                except Exception:
                    continue
                n += 1
                total += st.st_size
                mn = st.st_mtime if mn is None else min(mn, st.st_mtime)
                mx = st.st_mtime if mx is None else max(mx, st.st_mtime)
    except Exception:
        pass
    return n, total, mn, mx


def coast_running():
    return bool(run(["/usr/bin/pgrep", "-f", "Coast Local"], timeout=10).strip())


def specific_detail(it):
    name = it["name"]
    low = name.lower()
    path = it.get("path") or ""
    if low.startswith("coast: videos") and os.path.isdir(path):
        n, total, mn, mx = dir_summary(path)
        rng = ""
        if mn and mx:
            rng = ", del %s al %s" % (datetime.datetime.fromtimestamp(mn).strftime("%d %b"),
                                       datetime.datetime.fromtimestamp(mx).strftime("%d %b %Y"))
        s = "%d clips de ~50 s (HEVC), %s%s." % (n, human(total), rng)
        if coast_running():
            s += " ⚠️ Coast está abierto: ciérralo antes de borrar."
        return s
    if low.startswith("coast: rem.db"):
        s = "Base SQLite de %s con el índice de frames, texto OCR y ventanas de Coast." % human(it["bytes"])
        if coast_running():
            s += " ⚠️ Coast está abierto: ciérralo antes de borrar."
        return s
    if low.startswith("cap:") and os.path.isdir(path):
        s = "Proyecto de grabación de Cap (%s, 30 fps)." % human(it["bytes"])
        try:
            meta = json.load(open(os.path.join(path, "recording-meta.json")))
            pn = meta.get("pretty_name")
            if pn:
                s = "Grabación «%s» (%s, 30 fps)." % (pn, human(it["bytes"]))
            if (meta.get("upload") or {}).get("state") == "Complete":
                link = (meta.get("sharing") or {}).get("link")
                s += " Ya está subida a la nube" + ((" (%s)" % link) if link else "") + "; borrar local no borra el enlace."
            else:
                s += " Aún no está subida a la nube; si la borras, se pierde."
        except Exception:
            pass
        return s
    if low.startswith("steam:"):
        return "Juego instalado (%s). Si lo borras, Steam lo tendrá que reinstalar." % human(it["bytes"])
    if low.startswith("instalador"):
        return "Instalador ya descargado. Si ya instalaste la app, no lo necesitas."
    if low.startswith("archivo grande"):
        return "Archivo personal de %s. No es caché; revísalo antes." % human(it["bytes"])
    if low.startswith("claude"):
        return "Versión anterior de Claude Code; se puede volver a descargar."
    return ""


def verdict(it):
    risk = it.get("risk")
    low = it["name"].lower()
    if risk == RISKY:
        return "⛔ No se puede borrar desde el agente.", "Protegido"
    if risk == SAFE:
        return "✅ Sí, se puede borrar.", "Bajo"
    if low.startswith("coast: rem.db"):
        return "⚠️ Sí, pero con cuidado.", "Alto (Coast pierde la búsqueda del historial)"
    if low.startswith("coast"):
        return "✅ Sí, se puede borrar.", "Medio (pierdes ese historial de pantalla)"
    if low.startswith("steam"):
        return "✅ Sí, se puede borrar.", "Medio (tendrías que reinstalar el juego)"
    if low.startswith("cap"):
        if is_cap_uploaded(it.get("path") or ""):
            return "✅ Sí, borrado permanente (ya está en la nube).", "Bajo (hay copia en la nube)"
        return "⚠️ Sí, se mueve a cuarentena (no está en la nube).", "Medio (pierdes la copia local)"
    if low.startswith("archivo grande"):
        return "⚠️ Sí, pero es un archivo tuyo.", "Alto (puedes perder ese archivo)"
    if low.startswith(("instalador", "claude")):
        return "✅ Sí, se puede borrar.", "Bajo"
    return "✅ Sí, se puede borrar.", "Medio"


def explain_item(it):
    key, emoji, title, desc = _desc_match(it["name"])
    deletes, keeps, impact = DETAILS.get(key, ("Los archivos de esa carpeta.", "Tus datos personales.", "Revísalo antes de borrar."))
    rel = it["path"].replace(HOME, "~", 1) if it.get("path") else ""
    v, risk_text = verdict(it)
    spec = specific_detail(it)
    ok_proc, proc = app_running(it.get("path") or "")
    if ok_proc:
        if it.get("risk") == SAFE:
            spec = (spec + " ℹ️ %s está abierto: el caché se borra igual y se regenera." % proc).strip()
        elif allow_open_delete(it.get("path") or ""):
            spec = (spec + " ℹ️ %s está abierto: se puede borrar igual; no borres la grabación en curso." % proc).strip()
        else:
            spec = (spec + " ⚠️ %s está abierto: puedes forzar el borrado, pero puede corromper sus datos." % proc).strip()
    return {"key": key, "emoji": emoji, "title": title, "what": desc,
            "deletes": deletes, "keeps": keeps, "impact": impact,
            "path": rel, "bytes": it["bytes"], "size": human(it["bytes"]), "risk": it["risk"],
            "verdict": v, "risk_text": risk_text, "specific": spec,
            "app_open": proc if ok_proc else None,
            "can_delete": it.get("risk") != RISKY}


def group_safe(safe):
    groups = {}
    for it in safe:
        info = explain_item(it)
        g = groups.setdefault(info["title"], {
            "title": info["title"], "emoji": info["emoji"], "bytes": 0,
            "paths": [], "deletes": info["deletes"], "keeps": info["keeps"],
            "impact": info["impact"]})
        g["bytes"] += it["bytes"]
        if info["path"]:
            g["paths"].append(info["path"])
    return list(groups.values())


# ------------------------------------------------------------------ scanning

def scan_safe():
    it = []

    for p in expand(os.path.join(HOME, "Library", "Caches", "*")):
        it.append(item("Cache: " + os.path.basename(p), p, SAFE))
    for p in expand(os.path.join(HOME, ".cache", "*")):
        it.append(item("~/.cache: " + os.path.basename(p), p, SAFE))
    for p in expand(os.path.join(HOME, "Library", "Application Support", "Caches", "*")):
        it.append(item("Updater: " + os.path.basename(p), p, SAFE))
    for p in [os.path.join(HOME, ".npm"), os.path.join(HOME, ".pnpm-store"),
              os.path.join(HOME, "Library", "Caches", "ms-playwright")]:
        if os.path.exists(p):
            it.append(item("Cache: " + os.path.basename(p), p, SAFE))

    for p in expand(os.path.join(HOME, "Library", "Logs", "*")):
        if os.path.basename(p) != "cleanup-agent":
            it.append(item("Logs: " + os.path.basename(p), p, SAFE))

    trash = os.path.join(HOME, ".Trash")
    if os.path.exists(trash):
        it.append(item("Papelera", trash, SAFE))

    notion = os.path.join(HOME, "Library", "Application Support", "Notion", "Partitions")
    for base in expand(os.path.join(notion, "*")):
        for sub in ("Service Worker", "Cache", "Code Cache", "GPUCache",
                    "DawnGPUCache", "DawnGraphiteCache", "DawnWebGPUCache"):
            p = os.path.join(base, sub)
            if os.path.exists(p):
                it.append(item("Notion: " + sub, p, SAFE))

    discord = os.path.join(HOME, "Library", "Application Support", "discord")
    for sub in ("Cache", "logs", "Shared Dictionary", "component_crx_cache",
                "Code Cache", "GPUCache", "GraphiteDawnCache", "DawnGraphiteCache",
                "DawnWebGPUCache"):
        p = os.path.join(discord, sub)
        if os.path.exists(p):
            it.append(item("Discord: " + sub, p, SAFE))

    aside = os.path.join(HOME, "Library", "Application Support", "Aside")
    for sub in ("component_crx_cache", "aside_component_crx_cache",
                "extensions_crx_cache", "Crashpad", "AsideUpdater"):
        p = os.path.join(aside, sub)
        if os.path.exists(p):
            it.append(item("Aside: " + sub, p, SAFE))

    steam = os.path.join(HOME, "Library", "Application Support", "Steam")
    for sub in ("appcache", "depotcache", "logs"):
        p = os.path.join(steam, sub)
        if os.path.exists(p):
            it.append(item("Cache: Steam " + sub, p, SAFE))

    rem = os.path.join(HOME, "Library", "Application Support", "inc.attention.rem")
    for sub in ("icons", "tfidf_cache.json"):
        p = os.path.join(rem, sub)
        if os.path.exists(p):
            it.append(item("Cache: Coast " + os.path.basename(sub), p, SAFE,
                           kind="file" if os.path.isfile(p) else "dir"))

    orb = os.path.join(HOME, "Library", "Group Containers", "HUAQ24HBR6.dev.orbstack")
    if os.path.exists(orb) and not os.path.exists("/Applications/OrbStack.app"):
        it.append(item("OrbStack: restos", orb, SAFE))

    swa = os.path.join(HOME, "Library", "Containers", "com.apple.Safari.WebApp",
                       "Data", "Library", "Containers")
    for p in expand(os.path.join(swa, "*", "Library", "Caches")):
        it.append(item("Safari WebApp: cache", p, SAFE))

    brew = "/opt/homebrew/bin/brew" if os.path.exists("/opt/homebrew/bin/brew") else "/usr/local/bin/brew"
    if os.path.exists(brew):
        out = run([brew, "cleanup", "-n"], timeout=60)
        m = re.search(r"approximately ([\d.]+)(KB|MB|GB)", out)
        est = 0
        if m:
            mult = {"KB": 1024, "MB": 1024 ** 2, "GB": 1024 ** 3}[m.group(2)]
            est = int(float(m.group(1)) * mult)
        it.append({"name": "Homebrew: brew cleanup -s", "path": "", "risk": SAFE,
                   "action": "brew", "kind": "brew", "bytes": est, "note": "estimado"})

    return [i for i in it if (i["bytes"] > 0 or i["kind"] == "brew")
            and not path_excluded(i.get("path", ""))]


def scan_medium():
    it = []
    for ext in ("dmg", "pkg", "iso"):
        for p in expand(os.path.join(HOME, "Downloads", "*." + ext)):
            it.append(item("Instalador: " + os.path.basename(p), p, MEDIUM, action="review", kind="file"))

    steam_common = os.path.join(HOME, "Library", "Application Support", "Steam", "steamapps", "common")
    for p in expand(os.path.join(steam_common, "*")):
        if os.path.isdir(p):
            it.append(item("Steam: " + os.path.basename(p), p, MEDIUM, action="review"))

    cap = os.path.join(HOME, "Library", "Application Support", "so.cap.desktop", "recordings")
    for p in expand(os.path.join(cap, "*")):
        if os.path.isdir(p) and p.endswith(".cap"):
            it.append(item("Cap: " + os.path.basename(p), p, MEDIUM, action="review"))

    rem = os.path.join(HOME, "Library", "Application Support", "inc.attention.rem")
    vids = os.path.join(rem, "videos")
    if os.path.isdir(vids):
        it.append(item("Coast: videos", vids, MEDIUM, action="review"))
    db = os.path.join(rem, "rem.db")
    if os.path.exists(db):
        it.append(item("Coast: rem.db", db, MEDIUM, action="review", kind="file"))

    out = run(["/usr/bin/find", HOME, "-type", "f", "-size", "+500M",
               "-not", "-path", "*/Library/*", "-not", "-path", "*/.Trash/*"], timeout=180)
    files = []
    for line in out.splitlines():
        try:
            files.append((os.path.getsize(line), line))
        except Exception:
            pass
    files.sort(reverse=True)
    for size, p in files[:15]:
        it.append({"name": "Archivo grande: " + os.path.basename(p), "path": p, "risk": MEDIUM,
                   "action": "review", "kind": "file", "bytes": size, "note": ""})

    vers = os.path.join(HOME, ".local", "share", "claude", "versions")
    if os.path.isdir(vers):
        vv = sorted([(du_bytes(os.path.join(vers, v)), os.path.join(vers, v)) for v in os.listdir(vers)], reverse=True)
        for size, p in vv[1:]:
            it.append({"name": "Claude version vieja: " + os.path.basename(p), "path": p,
                       "risk": MEDIUM, "action": "review", "kind": "file",
                       "bytes": size, "note": "se re-descarga"})
    return [i for i in it if not path_excluded(i.get("path", ""))]


def scan_risky():
    known = [
        ("☁️ iCloud Drive", os.path.join(HOME, "Library", "Mobile Documents")),
        ("🖼️ Fotos", os.path.join(HOME, "Pictures")),
    ]
    wa_root = os.path.join(HOME, "Library", "Mobile Documents",
                           "57T9237FN3~net~whatsapp~WhatsApp", "Accounts")
    for b in expand(os.path.join(wa_root, "*", "backup")):
        known.append(("☁️ WhatsApp backup (iCloud)", b))
    it = []
    for name, p in known:
        if os.path.exists(p):
            kind = "file" if os.path.isfile(p) else "dir"
            it.append(item(name, p, RISKY, action="review", kind=kind, note="solo con aprobacion"))
    return it


def tm_snapshots():
    out = run(["/usr/bin/tmutil", "listlocalsnapshots", "/"], timeout=60)
    return [l.strip() for l in out.splitlines() if "TimeMachine" in l]


def thin_snapshots():
    """Purga snapshots locales via helper con sudoers NOPASSWD (sin prompt)."""
    try:
        p = subprocess.run(["/usr/bin/sudo", "-n", "/usr/local/sbin/cleanup-thin-snapshots"],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=300)
        msg = (p.stdout or p.stderr).decode("utf-8", "replace").strip()
        log("thin snapshots rc=%d: %s" % (p.returncode, msg[:200]))
        return p.returncode == 0
    except Exception as e:
        log("thin snapshots error: %s" % e)
        return False


