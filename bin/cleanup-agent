#!/usr/bin/env python3
"""cleanup-agent: audita y (opcionalmente) limpia lo seguro de macOS.

Uso:
  cleanup-agent --report [--notify]        # solo escanea y genera reporte
  cleanup-agent --choose [--dry-run]       # elige IDs interactivamente
  cleanup-agent --pick S1,S4-S6 [--yes]    # borra IDs concretos de lo seguro
  cleanup-agent --apply-safe [--yes]       # borra TODO lo seguro (con confirmacion)

Nunca toca documentos personales, iCloud, Steam, Coast, Cap, etc.
"""

import argparse
