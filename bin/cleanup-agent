# ------------------------------------------------------------------ seguridad

DEFAULT_EXCLUDES = """# Rutas que cleanup-agent NUNCA tocará (una por línea, admite ~ y *)
~/Documents
~/Desktop
~/.ssh
~/Library/Mobile Documents
"""

APP_PROC = [
    ("inc.attention.rem", "coast local"),
    ("so.cap.desktop", "cap.app"),
    ("/application support/steam", "steam"),
    ("/discord", "discord"),
    ("/notion", "notion"),
    ("com.operasoftware.opera", "opera"),
    ("/aside", "aside"),
    ("/granola", "granola"),
    ("/raycast", "raycast"),
]

_PS_CACHE = {"ts": 0, "out": ""}


def ensure_excludes():
    if not os.path.exists(EXCLUDES_PATH):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(EXCLUDES_PATH, "w") as f:
            f.write(DEFAULT_EXCLUDES)
        os.chmod(EXCLUDES_PATH, 0o600)


_EXC_CACHE = {"ts": 0, "pats": []}


def load_excludes():
    now = time.time()
    if now - _EXC_CACHE["ts"] < 5:
        return _EXC_CACHE["pats"]
    ensure_excludes()
    pats = []
    try:
        with open(EXCLUDES_PATH) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    pats.append(os.path.expanduser(line))
    except Exception:
        pass
    _EXC_CACHE.update({"ts": now, "pats": pats})
    return pats


def path_excluded(path):
    if not path:
        return False
    p = os.path.realpath(os.path.expanduser(path))
    for pat in load_excludes():
        pat = os.path.expanduser(pat)
        if any(ch in pat for ch in "*?["):
            if fnmatch.fnmatch(p, pat) or fnmatch.fnmatch(os.path.basename(p), pat):
                return True
        else:
            pp = os.path.realpath(pat)
            if p == pp or p.startswith(pp + os.sep):
                return True
    return False


def add_exclude(path):
    ensure_excludes()
    with open(EXCLUDES_PATH, "a") as f:
        f.write(os.path.expanduser(path.strip()) + "\n")


def remove_exclude(path):
    ensure_excludes()
    target = os.path.expanduser(path.strip())
    lines = open(EXCLUDES_PATH).read().splitlines()
    keep = [l for l in lines if l.strip() != target]
    with open(EXCLUDES_PATH, "w") as f:
        f.write("\n".join(keep) + "\n")
    return len(lines) != len(keep)


def running_ps():
    now = time.time()
    if now - _PS_CACHE["ts"] > 10:
        _PS_CACHE["out"] = run(["/bin/ps", "-axo", "comm="], timeout=20).lower()
        _PS_CACHE["ts"] = now
    return _PS_CACHE["out"]


def app_for_path(path):
    low = (path or "").lower()
    for key, proc in APP_PROC:
        if key in low:
            return proc
    return None


def app_running(path):
    proc = app_for_path(path)
    if not proc:
        return (False, None)
    return (proc in running_ps(), proc)


def allow_open_delete(path):
    """Rutas que se pueden borrar aunque su app esté abierta."""
    low = (path or "").lower()
    return "so.cap.desktop/recordings" in low


def is_cap_uploaded(path):
    try:
        meta = json.load(open(os.path.join(path, "recording-meta.json")))
        return (meta.get("upload") or {}).get("state") == "Complete"
    except Exception:
        return False


def should_quarantine(it):
    if it.get("risk") == SAFE:
        return False
    if it.get("name", "").lower().startswith("cap:") and is_cap_uploaded(it.get("path") or ""):
        return False
    return True


def validate_item(it, force_open=False):
    path = it.get("path") or ""
    if not path:
        return False, "sin ruta"
    if not os.path.exists(path):
        return False, "ya no existe"
    real = os.path.realpath(path)
    root = os.path.realpath(HOME)
    if real == root:
        return False, "es tu carpeta raíz"
    if not real.startswith(root + os.sep):
        return False, "fuera de tu carpeta"
    if os.path.islink(path):
        return False, "es un enlace simbólico"
    if path_excluded(path):
        return False, "está en exclusiones"
    ok_proc, proc = app_running(path)
    if ok_proc and it.get("risk") != SAFE and not allow_open_delete(path) and not force_open:
        return False, "app abierta (%s)" % proc
    if not (os.path.isfile(path) or os.path.isdir(path)):
        return False, "ya no es archivo ni carpeta"
    return True, ""


def quarantine_ensure():
    os.makedirs(QUARANTINE_DIR, exist_ok=True)


def quarantine_add(it):
    quarantine_ensure()
    src = it.get("path")
    if not src or not os.path.exists(src):
        return None
    eid = datetime.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + \
        hashlib.sha1((src + str(time.time())).encode()).hexdigest()[:6]
    edir = os.path.join(QUARANTINE_DIR, eid)
    os.makedirs(edir, exist_ok=True)
    payload = os.path.join(edir, "payload")
    try:
        shutil.move(src, payload)
    except Exception as e:
        log("quarantine move error %s: %s" % (src, e))
        shutil.rmtree(edir, ignore_errors=True)
        return None
    meta = {"id": eid, "name": it.get("name"), "original_path": src,
            "bytes": it.get("bytes", 0), "risk": it.get("risk"),
            "kind": it.get("kind"), "created_at": time.time(),
            "expires_at": time.time() + QUARANTINE_DAYS * 86400}
    with open(os.path.join(edir, "meta.json"), "w") as f:
        json.dump(meta, f, indent=2)
    log("quarantine %s -> %s" % (src, eid))
    return eid


def quarantine_list():
    quarantine_ensure()
    out = []
    for eid in sorted(os.listdir(QUARANTINE_DIR)):
        edir = os.path.join(QUARANTINE_DIR, eid)
        mp = os.path.join(edir, "meta.json")
        if os.path.isdir(edir) and os.path.exists(mp):
            try:
                meta = json.load(open(mp))
                meta["id"] = eid
                meta["days_left"] = max(0, int((meta.get("expires_at", 0) - time.time()) // 86400))
                out.append(meta)
            except Exception:
                pass
    return out


def quarantine_restore(eid):
    meta = {e["id"]: e for e in quarantine_list()}.get(eid)
    if not meta:
        return False, "no existe"
    edir = os.path.join(QUARANTINE_DIR, eid)
    payload = os.path.join(edir, "payload")
    dest = meta.get("original_path", "")
    if not dest:
        return False, "sin ruta original"
    if os.path.exists(dest):
        return False, "la ruta original ya existe"
    try:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        shutil.move(payload, dest)
    except Exception as e:
        return False, str(e)
    shutil.rmtree(edir, ignore_errors=True)
    log("restored %s -> %s" % (eid, dest))
    return True, dest


def quarantine_purge(eid=None):
    quarantine_ensure()
    ids = [eid] if eid else os.listdir(QUARANTINE_DIR)
    purged, freed = 0, 0
    for e in ids:
        edir = os.path.join(QUARANTINE_DIR, e)
        if not os.path.isdir(edir):
            continue
        try:
            freed += json.load(open(os.path.join(edir, "meta.json"))).get("bytes", 0)
        except Exception:
            pass
        shutil.rmtree(edir, ignore_errors=True)
        purged += 1
    log("quarantine purge: %d entries, ~%s" % (purged, human(freed)))
    return purged, freed


def quarantine_autopurge():
    now = time.time()
    purged, freed = 0, 0
    for meta in quarantine_list():
        if meta.get("expires_at", 0) < now:
            shutil.rmtree(os.path.join(QUARANTINE_DIR, meta["id"]), ignore_errors=True)
            freed += meta.get("bytes", 0)
            purged += 1
    if purged:
        log("quarantine autopurge: %d entries, ~%s" % (purged, human(freed)))
    return purged, freed


def gather():
    quarantine_autopurge()
    safe = scan_safe()
    medium = scan_medium()
    risky = scan_risky()
    safe.sort(key=lambda x: -x["bytes"])
    medium.sort(key=lambda x: -x["bytes"])
    risky.sort(key=lambda x: -x["bytes"])
    for idx, s in enumerate(safe, 1):
        s["id"] = "S%d" % idx
    return safe, medium, risky, tm_snapshots()


def report_text(safe, medium, risky, snaps):
    now = datetime.datetime.now()
    t_safe = sum(i["bytes"] for i in safe)
    t_med = sum(i["bytes"] for i in medium)
    t_risk = sum(i["bytes"] for i in risky)
    d = disk_info()
    tops = top_consumers(8)
    mi = machine_info()
    L = []
    L.append("# 🧹 Reporte cleanup-agent")
    L.append("💻 **%s** — %s (%s) · %s · %s" % (mi["name"], mi["model"], mi["model_id"], mi["chip"], mi["memory"]))
    L.append("🗓️ %s" % now.strftime("%Y-%m-%d %H:%M"))
    L.append("")
    L.append("## 💽 Disco")
    L.append("")
    L.append("| Total | Usado | Libre |")
    L.append("|---:|---:|---:|")
    L.append("| %s | %s | **%s** |" % (human(d["total"]), human(d["used"]), human(d["free"])))
    L.append("")
    L.append("### 📦 En qué se usa")
    L.append("")
    L.append("| Qué | Tamaño |")
    L.append("|---|---:|")
    for it in disk_breakdown():
        L.append("| %s %s | %s |" % (it["emoji"], it["name"], human(it["bytes"])))
    L.append("")
    L.append("## 📊 Resumen")
    L.append("")
    L.append("| Nivel | Tamaño |")
    L.append("|---|---|")
    L.append("| 🟢 Seguro (tú eliges) | **%s** |" % human(t_safe))
    L.append("| 🟡 Revisar antes | %s |" % human(t_med))
    L.append("| 🔴 Protegido (nunca automático) | %s |" % human(t_risk))
    L.append("| ♻️ Potencial de liberación | **%s** |" % human(t_safe + t_med))
    L.append("| 💾 Snapshots Time Machine | %d |" % len(snaps))
    L.append("")
    L.append("## 🏆 Qué ocupa más")
    L.append("")
    L.append("| Qué | Tamaño | Qué es |")
    L.append("|---|---:|---|")
    for size, p in tops:
        nm = display_name(p)
        L.append("| %s %s | %s | %s |" % (icon_for(nm), nm, human(size), APP_INFO.get(nm, "—")))
    L.append("")
    L.append("## ℹ️ Qué es cada cosa")
    L.append("")
    seen = set()
    for it in safe + medium + risky:
        e, t, dd = describe(it["name"])
        if t in seen:
            continue
        seen.add(t)
        L.append("- %s **%s**: %s" % (e, t, dd))
    L.append("")
    L.append("## 🧾 Qué se borra exactamente (solo 🟢 Seguro)")
    L.append("")
    for g in group_safe(safe):
        L.append("### %s %s — %s" % (g["emoji"], g["title"], human(g["bytes"])))
        L.append("")
        L.append("- **Se borra:** %s" % g["deletes"])
        if g["paths"]:
            extra = " _(+%d rutas)_" % (len(g["paths"]) - 1) if len(g["paths"]) > 1 else ""
            L.append("- **Ruta:** `%s`%s" % (g["paths"][0], extra))
        L.append("- **No se borra:** %s" % g["keeps"])
        L.append("- **Impacto:** %s" % g["impact"])
        L.append("")
    L.append("## 🟢 Seguro — elige qué borrar")
    L.append("")
    L.append("_Solo cachés y temporales. Tus documentos, fotos, chats y sesiones no se tocan._")
    L.append("")
    L.append("| ID | Qué | Tamaño |")
    L.append("|:--:|---|---:|")
    for s in safe[:50]:
        L.append("| `%s` | %s %s | %s |" % (s["id"], icon_for(s["name"]), s["name"], human(s["bytes"])))
    if len(safe) > 50:
        L.append("| … | _y %d más_ | |" % (len(safe) - 50))
    L.append("")
    L.append("**Cómo elegir:**")
    L.append("")
    L.append("- `cleanup-agent --choose` → menú interactivo")
    L.append("- `cleanup-agent --pick S1,S4-S6` → borra solo esos")
    L.append("- `cleanup-agent --apply-safe` → todo lo seguro")
    L.append("- añade `--dry-run` para simular")
    L.append("")
    L.append("## 🟡 Revisar (se puede borrar con confirmación)")
    L.append("")
    L.append("| Qué | Tamaño | ¿Se puede borrar? | Riesgo |")
    L.append("|---|---:|---|---|")
    if medium:
        for m in medium[:25]:
            inf = explain_item(m)
            L.append("| %s %s | %s | %s | %s |" % (inf["emoji"], m["name"], human(m["bytes"]),
                                                   inf["verdict"], inf["risk_text"]))
    else:
        L.append("| — | — | — | — |")
    L.append("")
    L.append("## 🔴 Protegido (solo lectura, nunca se borra)")
    L.append("")
    L.append("| Qué | Tamaño | ¿Se puede borrar? |")
    L.append("|---|---:|---|")
    for r in risky:
        L.append("| %s | %s | ⛔ No |" % (r["name"], human(r["bytes"])))
    L.append("")
    L.append("## 🧾 Detalle de Revisar")
    L.append("")
    for m in medium:
        inf = explain_item(m)
        L.append("### %s %s — %s" % (inf["emoji"], m["name"], human(m["bytes"])))
        L.append("")
        L.append("- **¿Se puede borrar?** %s · riesgo: %s" % (inf["verdict"], inf["risk_text"]))
        if inf["specific"]:
            L.append("- **Detalle:** %s" % inf["specific"])
        L.append("- **Se borra:** %s" % inf["deletes"])
        L.append("- **No se borra:** %s" % inf["keeps"])
        L.append("- **Impacto:** %s" % inf["impact"])
        L.append("")
    L.append("## 🧾 Detalle de Protegido")
    L.append("")
    for r in risky:
        inf = explain_item(r)
        L.append("### %s %s — %s" % (inf["emoji"], inf["title"], human(r["bytes"])))
        L.append("")
        L.append("- **⛔ No se puede borrar desde el agente.**")
        L.append("- **Qué es:** %s" % inf["what"])
        if inf["specific"]:
            L.append("- **Detalle:** %s" % inf["specific"])
        L.append("- **Contiene:** %s" % inf["deletes"])
        L.append("- **Se conserva:** %s" % inf["keeps"])
        L.append("")
    if snaps:
        L.append("## 💾 Snapshots locales")
        L.append("")
        for s in snaps:
            L.append("- `%s`" % s)
        L.append("")
    ql = quarantine_list()
    if ql:
        L.append("## 🗂 Cuarentena (%d)" % len(ql))
        L.append("")
        for e in ql:
            L.append("- `%s` — %s · %s · %d días → `%s`" %
                     (e["id"], e.get("name"), human(e.get("bytes", 0)),
                      e.get("days_left", 0), e.get("original_path")))
        L.append("")
    L.append("---")
    L.append("_cleanup-agent no borra nada por sí solo. Solo borra cuando tú eliges._")
    return "\n".join(L)


def write_report(text):
    now = datetime.datetime.now()
    os.makedirs(REPORT_DIR, exist_ok=True)
    latest = os.path.join(REPORT_DIR, "report-latest.md")
    dated = os.path.join(REPORT_DIR, "report-%s.md" % now.strftime("%Y-%m-%d"))
    for p in (latest, dated):
        with open(p, "w") as f:
            f.write(text + "\n")
    return latest


# ------------------------------------------------------------------ selection

def parse_selection(text, safe):
    n = len(safe)
    text = text.strip().lower()
    if text in ("", "n", "no", "ninguno", "none"):
        return []
    if text in ("todos", "all", "*"):
        return list(range(n))
    picked = set()
    for part in re.split(r"[,\s]+", text):
        if not part:
            continue
        m = re.match(r"s?(\d+)(?:-s?(\d+))?$", part)
        if not m:
            continue
        a = int(m.group(1))
        b = int(m.group(2)) if m.group(2) else a
        for k in range(a, b + 1):
            if 1 <= k <= n:
                picked.add(k - 1)
    return sorted(picked)


def print_items(items):
    for s in items:
        print("  %-4s %-45s %10s" % (s.get("id", ""),
                                     (icon_for(s["name"]) + " " + s["name"])[:45],
                                     human(s.get("bytes", 0))))


def apply_items(items, yes=False, dry_run=False, thin=False, quarantine=True, force_open=False):
    empty = {"freed": 0, "deleted": 0, "quarantined": 0, "quarantined_items": [],
             "skipped": [], "errors": []}
    items = [i for i in items if (i.get("bytes", 0) > 0 or i.get("kind") == "brew")]
    if not items:
        print("No hay nada que borrar en la selección.")
        return empty
    total = sum(i.get("bytes", 0) for i in items)
    print("\nSeleccionado: %d items, %s\n" % (len(items), human(total)))
    print_items(items)
    if dry_run:
        print("\n🔎 DRY-RUN: no se borró nada.")
        return empty
    if not yes:
        try:
            ans = input("\n¿Procesar estos %d items (%s)? [s/N] " % (len(items), human(total))).strip().lower()
        except EOFError:
            ans = "n"
        if ans not in ("s", "si", "sí", "y", "yes"):
            print("Cancelado.")
            return empty
    quarantine_autopurge()
    log("apply start: %d items, %s" % (len(items), human(total)))
    free_before = disk_info()["free"]
    freed = 0
    deleted = 0
    qbytes = 0
    skipped = []
    skipped_items = []
    errors = []
    qitems = []
    for i in items:
        try:
            if i.get("kind") == "brew":
                print("🍺 Homebrew cleanup…")
                run(["/opt/homebrew/bin/brew", "cleanup", "-s"], timeout=600)
                log("brew cleanup -s")
                continue
            path = i.get("path") or ""
            ok, reason = validate_item(i, force_open=force_open)
            if not ok:
                skipped.append((i.get("name", "?"), reason))
                if reason.startswith("app abierta"):
                    skipped_items.append(i)
                print("  ⏭  %s (%s)" % (i.get("name", "?"), reason))
                log("skip %s: %s" % (path, reason))
                continue
            if quarantine and should_quarantine(i):
                eid = quarantine_add(i)
                if eid:
                    qbytes += i.get("bytes", 0)
                    qitems.append({"id": eid, "name": i.get("name", "?"),
                                   "bytes": i.get("bytes", 0)})
                    print("  📦 %s → cuarentena" % i.get("name", "?"))
                else:
                    errors.append((i.get("name", "?"), "no se pudo mover a cuarentena"))
                continue
            if i.get("kind") == "file" or os.path.isfile(path):
                os.remove(path)
            else:
                shutil.rmtree(path, ignore_errors=True)
            freed += i.get("bytes", 0)
            deleted += 1
            print("  ✅ %s" % i.get("name", "?"))
            log("deleted %s (%s)" % (path, human(i.get("bytes", 0))))
        except Exception as e:
            errors.append((i.get("name", "?"), str(e)))
            print("  ⚠️  %s: %s" % (i.get("name", "?"), e))
            log("error deleting %s: %s" % (i.get("path", "?"), e))
    if not dry_run and thin and freed > 0:
        free_after = disk_info()["free"]
        if (free_after - free_before) < freed * 0.5 and tm_snapshots():
            log("espacio retenido por snapshots; purgando")
            thin_snapshots()
    print("\n🎉 Listo.")
    if freed:
        print("   Borrado permanente: %s" % human(freed))
    if qbytes:
        print("   En cuarentena: %s (recuperable %d días)" % (human(qbytes), QUARANTINE_DAYS))
    if skipped:
        print("   Omitidos: %d" % len(skipped))
    if errors:
        print("   Errores: %d" % len(errors))
    log("apply done: %d deleted, freed ~%s, quarantined ~%s, skipped %d, errors %d" %
        (deleted, human(freed), human(qbytes), len(skipped), len(errors)))
    return {"freed": freed, "deleted": deleted, "quarantined": qbytes,
            "quarantined_items": qitems, "skipped": skipped,
            "skipped_items": skipped_items, "errors": errors}


def choose_interactive(safe, dry_run=False):
    if not safe:
        print("No hay nada seguro.")
        return
    print("\n🟢 SEGURO — elige qué borrar\n")
    print_items(safe)
    ans = input("\nIDs (ej: S1,S4-S6) · 'todos' · Enter=salir: ")
    sel = parse_selection(ans, safe)
    if not sel:
        print("Nada seleccionado.")
        return
    apply_items([safe[i] for i in sel], yes=False, dry_run=dry_run, thin=True)


# ------------------------------------------------------------------ notify

def load_config():
    defaults = {"notify": {"macos": True,
                           "telegram": {"enabled": True, "bot_token": "", "chat_id": ""}}}
    if not os.path.exists(CONFIG_PATH):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_PATH, "w") as f:
            json.dump(defaults, f, indent=2)
        os.chmod(CONFIG_PATH, 0o600)
        return defaults
    try:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f)
        cfg.setdefault("notify", {})
        cfg["notify"].setdefault("macos", True)
        cfg["notify"].setdefault("telegram", {"enabled": True, "bot_token": "", "chat_id": ""})
        return cfg
    except Exception:
        return defaults


def keychain_get(account, service="cleanup-agent-telegram"):
    try:
        p = subprocess.run(["/usr/bin/security", "find-generic-password",
                            "-a", account, "-s", service, "-w"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
        if p.returncode == 0:
            return p.stdout.decode("utf-8", "replace").strip()
    except Exception:
        pass
    return ""


def telegram_send(text, parse_mode="HTML"):
    try:
        import urllib.parse
        import urllib.request
        cfg = load_config()["notify"]["telegram"]
        token = cfg.get("bot_token") or keychain_get("bot_token")
        chat = cfg.get("chat_id") or keychain_get("chat_id")
        if not cfg.get("enabled") or not token or not chat:
            return False
        data = {"chat_id": chat, "text": text}
        if parse_mode:
            data["parse_mode"] = parse_mode
        url = "https://api.telegram.org/bot%s/sendMessage" % token
        body = urllib.parse.urlencode(data).encode()
        urllib.request.urlopen(urllib.request.Request(url, data=body), timeout=25).read()
        return True
    except Exception as e:
        log("telegram error: %s" % e)
        return False


def notify(safe, medium, risky, report_path):
    t_safe = sum(i["bytes"] for i in safe)
    t_med = sum(i["bytes"] for i in medium)
    t_risk = sum(i["bytes"] for i in risky)
    d = disk_info()
    mi = machine_info()
    pct = int(round(100.0 * d["used"] / d["total"])) if d["total"] else 0
    lines = ["🤖🧹 <b>cleanup-agent</b>",
             "<i>%s · %s</i>" % (html.escape(mi["name"]), html.escape(mi["model"])),
             "",
             "💽 <b>Disco</b>  %s <b>%d%%</b>" % (bar(pct), pct),
             "Libre: <b>%s</b> de %s" % (human(d["free"]), human(d["total"])),
             "",
             "🟢 Seguro: <b>%s</b>" % human(t_safe),
             "🟡 Revisar: %s" % human(t_med),
             "♻️ Potencial: <b>%s</b>" % human(t_safe + t_med),
             "🔴 Protegido: %s" % human(t_risk), ""]
    if safe:
        lines.append("<b>Top para borrar</b>")
        for s in safe[:5]:
            lines.append("• %s %s — %s" % (icon_for(s["name"]), html.escape(s["name"]), human(s["bytes"])))
        lines.append("")
    lines.append("Abre el bot y usa /limpiar para elegir.")
    msg = "\n".join(lines)
    cfg = load_config()
    if cfg["notify"].get("macos", True):
        run(["/usr/bin/osascript", "-e",
             'display notification "%s" with title "Cleanup Agent" subtitle "Toca: cleanup-agent --choose"'
             % ("Seguro: " + human(t_safe))], timeout=20)
    telegram_send(msg)


# ------------------------------------------------------------------ main

def main():
    ap = argparse.ArgumentParser(description="Audita y limpia lo seguro de macOS.")
    ap.add_argument("--report", action="store_true")
    ap.add_argument("--apply-safe", action="store_true")
    ap.add_argument("--choose", action="store_true", help="menú interactivo de IDs")
    ap.add_argument("--pick", help="IDs a borrar, ej: S1,S4-S6")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--notify", action="store_true")
    ap.add_argument("--yes", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--quarantine-list", action="store_true")
    ap.add_argument("--restore", help="ID de cuarentena a restaurar")
    ap.add_argument("--purge-quarantine", action="store_true")
    ap.add_argument("--excludes", action="store_true")
    ap.add_argument("--add-exclude", help="añadir ruta a exclusiones")
    args = ap.parse_args()

    if args.quarantine_list:
        ql = quarantine_list()
        if not ql:
            print("Cuarentena vacía.")
        for e in ql:
            print("%s  %8s  %-30s  %d días  -> %s" %
                  (e["id"], human(e.get("bytes", 0)), e.get("name"),
                   e.get("days_left", 0), e.get("original_path")))
        return
    if args.restore:
        ok, msg = quarantine_restore(args.restore)
        print(("✅ Restaurado: " if ok else "⚠️  ") + msg)
        return
    if args.purge_quarantine:
        n, f = quarantine_purge()
        print("Purgados %d entries, liberado ≈ %s" % (n, human(f)))
        return
    if args.excludes:
        print("\n".join(load_excludes()))
        return
    if args.add_exclude:
        add_exclude(args.add_exclude)
        print("Añadido a exclusiones: %s" % args.add_exclude)
        return

    safe, medium, risky, snaps = gather()

    if args.apply_safe:
        apply_items(safe, yes=args.yes, dry_run=args.dry_run, thin=True)
        return
    if args.choose:
        choose_interactive(safe, dry_run=args.dry_run)
        return
    if args.pick:
        sel = parse_selection(args.pick, safe)
        if not sel:
            print("IDs inválidos o vacíos. Usa por ejemplo: --pick S1,S4-S6")
            return
        apply_items([safe[i] for i in sel], yes=args.yes, dry_run=args.dry_run, thin=True)
        return

    text = report_text(safe, medium, risky, snaps)
    path = write_report(text)
    if args.json:
        print(json.dumps({"safe": safe, "medium": medium, "risky": risky,
                          "snapshots": snaps}, indent=2))
    else:
        print(text)
    if args.notify:
        notify(safe, medium, risky, path)
    log("report: safe=%s medium=%s risky=%s snaps=%d" %
        (human(sum(i["bytes"] for i in safe)), human(sum(i["bytes"] for i in medium)),
         human(sum(i["bytes"] for i in risky)), len(snaps)))


if __name__ == "__main__":
    main()
